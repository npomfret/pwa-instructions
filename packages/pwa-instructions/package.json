{
  "name": "pwa-instructions",
  "version": "0.1.0",
  "description": "PWA installation guides, browser detection and optional React components.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/assets",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./assets/*": "./dist/assets/*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/npomfret/pwa-instructions.git",
    "directory": "packages/pwa-instructions"
  },
  "homepage": "https://github.com/npomfret/pwa-instructions#readme",
  "bugs": {
    "url": "https://github.com/npomfret/pwa-instructions/issues"
  },
  "keywords": [
    "pwa",
    "install",
    "instructions",
    "react",
    "svg"
  ],
  "publishConfig": {
    "access": "public"
  }
}
